<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Sequence for each created approval-->
        <record id="approval_sequence" model="ir.sequence">
            <field name="name">Approval Sequence</field>
            <field name="code">dynamic.approval</field>
            <field name="prefix">AP</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>