<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Template for report cancel dynamic approval-->
    <template id="all_in_one_dynamic_approvals_pro_templates">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <h2>
                    <strong>Dynamical Approval
                        <span>
                            <t t-esc="self.approval_name"/>
                        </span>
                        <t t-if="table_data == 'no'">
                            Created Report
                        </t>
                        <t t-else="">
                            Cancel Report
                        </t>

                    </strong>
                </h2>
                <br/>
                <h5>Approval Name:
                    <span>
                        <t t-esc="self.approval_name"/>
                    </span>
                </h5>
                <h5>Model:
                    <span>
                        <t t-esc="self.model_id.name"/>
                    </span>
                </h5>
                <h5>Responsible Person:
                    <span>
                        <t t-esc="self.create_uid.name"/>
                    </span>
                </h5>
                <h5>Created Date:
                    <span>
                        <t t-esc="created_date"/>
                    </span>
                </h5>
                <t t-if="table_data == 'no'">

                </t>
                <t t-else="">
                    <h5>Cancelled Date:
                        <span>
                            <t t-esc="cancelled_date"/>
                        </span>
                    </h5>
                </t>
                <t t-if="table_data == 'no'">
                    <h5>Created By:
                        <span>
                            <t t-esc="created.name"/>
                        </span>
                    </h5>
                </t>
                <t t-else="">
                    <h5>Created By:
                        <span>
                            <t t-esc="cancelled.name"/>
                        </span>
                    </h5>
                </t>
                <h5>Approval Method:
                    <span>
                        <t t-esc="self.approval_method"/>
                        <span style="margin-left:1%;">Approval</span>
                    </span>
                </h5>
                <h5>Company Name:
                    <span>
                        <t t-esc="company_name"/>
                    </span>
                </h5>
                <h5>Action Name:
                    <span>
                        <t t-esc="Action"/>
                    </span>
                </h5>
                <br/>
                <t t-if="table_data != 'no'">
                    <h5>Records to approve in mentioned state</h5>
                    <table class="table" style="border: solid gray 4px">
                        <thead style="border: solid gray 4px">
                            <tr>
                                <th>State</th>
                                <th>No.of records</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="table_data.items()" t-as="data">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span>
                                            <t t-esc="data[0]"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span>
                                            <t t-esc="data[1]"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                            <br/>
                        </tbody>
                    </table>
                </t>
                <br/>
                <t t-if="self.users">
                    <table class="table" style="border: solid gray 4px">
                        <tbody>
                            <h5>Approvers of the Dynamical Approval
                                <span>
                                    <t t-esc="self.approval_name"/>
                                </span>
                            </h5>
                            <br/>
                            <thead style="border: solid gray 4px">
                                <tr>
                                    <th>Approval sequence</th>
                                    <th>Approval type</th>
                                    <th>Approver</th>
                                </tr>
                            </thead>
                            <t t-foreach="self.users" t-as="user">
                                <tr>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span>
                                            <t t-esc="user.sequence"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span>
                                            <t t-esc="user.approval_type_id.name"/>
                                        </span>
                                    </td>
                                    <td style="text-align: center; vertical-align: middle;">
                                        <span>
                                            <t t-esc="user.user_ids.name"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </t>
    </template>
</odoo>