<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--Action for the model add.approval-->
        <record id="approval_add_menu_action" model="ir.actions.act_window">
            <field name="name">AddApproval</field>
            <field name="res_model">add.approval</field>
            <field name="view_mode">list,form</field>
        </record>
        <!--Tree view for the model add.approval-->
        <record id="approval_add_list_view" model="ir.ui.view">
            <field name="name">approval.add.list</field>
            <field name="model">add.approval</field>
            <field name="arch" type="xml">
                <list>
                    <field name="model_id"/>
                </list>
            </field>
        </record>
        <!--Form view for the model add.approval-->
        <record id="approval_add_form" model="ir.ui.view">
            <field name="name">approval.add.form</field>
            <field name="model">add.approval</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                        <button name="add_approve" string="Add Approval"
                                type="object"
                                class="oe_highlight"
                                invisible="state == 'confirm'"
                                groups="all_in_one_dynamic_approvals_pro.group_all_in_one_dynamic_approval_manager"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="model_id" readonly="state == 'confirm'" required="True"/>
                            <field name="record_ids" widget="many2many_tags" readonly="state == 'confirm'" required="True"/>
                        </group>
                    </sheet>
<!--                    <div class="oe_chatter">-->
<!--                        <field name="message_follower_ids"/>-->
<!--                        <field name="activity_ids"/>-->
<!--                        <field name="message_ids"/>-->
<!--                    </div>-->
                </form>
            </field>
        </record>
        <!--Menu item Add approval -->
        <menuitem id="approval_add_menu_view"
                  name="Add Approval"
                  parent="all_in_one_dynamic_approvals_pro.approval_menu_view"
                  action="approval_add_menu_action"
                  groups="group_all_in_one_dynamic_approval_manager"
                  sequence="3"/>
    </data>
</odoo>
