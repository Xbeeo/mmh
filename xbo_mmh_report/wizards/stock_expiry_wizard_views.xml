<odoo>
    <record id="view_stock_expiry_wizard" model="ir.ui.view">
        <field name="name">stock.expiry.wizard.form</field>
        <field name="model">stock.expiry.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Expiry Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_expiry_wizard" model="ir.actions.act_window">
        <field name="name">Stock Expiry Report</field>
        <field name="res_model">stock.expiry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_expiry_report"
              name="Stock Expiry Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_expiry_wizard"
              sequence="51"/>
</odoo>