<odoo>
    <record id="view_purchase_analysis_wizard" model="ir.ui.view">
        <field name="name">purchase.analysis.wizard.form</field>
        <field name="model">purchase.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Analysis Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="partner_id"/>
                        <field name="open_purchase"/>
                        <field name="pending_payment"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_purchase_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Analysis Report</field>
        <field name="res_model">purchase.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_purchase_analysis_report"
              name="Purchase Analysis Report"
              parent="purchase.purchase_report_main"
              action="action_purchase_analysis_wizard"
              sequence="50"/>
</odoo>