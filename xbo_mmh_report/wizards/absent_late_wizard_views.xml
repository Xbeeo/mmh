<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Wizard Form -->

    <record id="view_absent_late_wizard_form" model="ir.ui.view">
        <field name="name">absent.late.wizard.form</field>
        <field name="model">absent.late.wizard</field>
        <field name="arch" type="xml">
            <form string="Absent &amp; Late Employee">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button
                        name="action_print_report"
                        string="Print PDF"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action -->

    <record id="action_absent_late_wizard" model="ir.actions.act_window">
        <field name="name">Absent &amp; Late Employee</field>
        <field name="res_model">absent.late.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

    <!-- Menu -->

    <menuitem
        id="menu_absent_late_employee"
        name="Absent &amp; Late Employee"
        parent="hr_attendance.menu_hr_attendance_reporting"
        action="action_absent_late_wizard"
        sequence="60"
        groups="hr_attendance.group_hr_attendance_manager"
    />

</odoo>