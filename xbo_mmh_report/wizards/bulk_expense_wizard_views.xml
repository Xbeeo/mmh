<odoo>
    <record id="view_bulk_expense_wizard" model="ir.ui.view">
        <field name="name">bulk.expense.wizard.form</field>
        <field name="model">bulk.expense.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="employee_id"/>
                </group>
                <footer>
                    <button string="Print" name="action_print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_expense_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Expense Report</field>
        <field name="res_model">bulk.expense.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bulk_expense_report" name="Bulk Expense Report"
              parent="hr_expense.menu_hr_expense_reports"
              action="action_bulk_expense_wizard" sequence="50"/>
</odoo>