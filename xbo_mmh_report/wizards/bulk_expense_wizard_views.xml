<odoo>
    <record id="view_bulk_expense_wizard_form" model="ir.ui.view">
        <field name="name">bulk.expense.wizard.form</field>
        <field name="model">bulk.expense.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Expense Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="employee_id"/>
                    </group>
                    <group>
<!--                        <field name="department_id"/>-->
                        <field name="account_id"/>
                        <field name="product_id"/>
                        <field name="state"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print PDF" type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bulk_expense_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Expense Report</field>
        <field name="res_model">bulk.expense.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bulk_expense_report" name="Bulk Expense Report"
              parent="hr_expense.menu_hr_expense_reports"
              action="action_bulk_expense_wizard" sequence="50"/>
</odoo>