<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_send_email_user_list" model="ir.ui.view">
        <field name="name">send.email.user.list</field>
        <field name="model">send.email.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_send_email_user_form" model="ir.ui.view">
        <field name="name">send.email.user.form</field>
        <field name="model">send.email.user</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="email"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_send_email_user" model="ir.actions.act_window">
        <field name="name">Send Email User</field>
        <field name="res_model">send.email.user</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_send_email_user"
        name="Send Email User"
        parent="hr_attendance.menu_hr_attendance_configuration"
        action="action_send_email_user"
        sequence="50"
    />

</odoo>